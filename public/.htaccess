Options -MultiViews
RewriteEngine On

# ── 1. Force HTTPS ──────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── 2. Force www ─────────────────────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^energosoyuz\.com$ [NC]
RewriteRule ^ https://www.energosoyuz.com%{REQUEST_URI} [R=301,L]

# ── 3. Strip WordPress ghost query params → clean redirect to / ──────────────
RewriteCond %{QUERY_STRING} (^|&)p= [NC]
RewriteRule ^$ /? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id= [NC]
RewriteRule ^$ /? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)feed= [NC]
RewriteRule ^$ /? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)replytocom= [NC]
RewriteRule ^$ /? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)s= [NC]
RewriteRule ^$ /? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)author= [NC]
RewriteRule ^$ /? [R=301,L]

# ── 4. React Router — serve index.html for all routes ───────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ── 5. Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── 6. Cache static assets ───────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
