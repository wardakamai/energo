{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "energosoyuz.com" }],
      "destination": "https://www.energosoyuz.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "p" }],
      "destination": "https://www.energosoyuz.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page_id" }],
      "destination": "https://www.energosoyuz.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "feed" }],
      "destination": "https://www.energosoyuz.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "replytocom" }],
      "destination": "https://www.energosoyuz.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
